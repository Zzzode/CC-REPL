{
  "name": "loom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build.mjs",
    "migration:inventory": "node scripts/cpp-migration-inventory.mjs",
    "migration:inventory:json": "node scripts/cpp-migration-inventory.mjs --json",
    "migration:e2e": "node scripts/cpp-migration-e2e.mjs",
    "migration:ctest-gates": "node scripts/cpp-migration-ctest-gates.mjs",
    "start": "./dist/loom",
    "start:cu": "ALLOW_ANT_COMPUTER_USE_MCP=1 DISABLE_TELEMETRY= ./dist/loom",
    "start:cu:mcp": "ALLOW_ANT_COMPUTER_USE_MCP=1 DISABLE_TELEMETRY= ./dist/loom --computer-use-mcp"
  },
  "dependencies": {},
  "devDependencies": {}
}
